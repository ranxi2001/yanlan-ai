{
  "name": "yanlan-ai",
  "version": "0.7.0",
  "type": "module",
  "description": "Yanlan: an open-source AI meeting workspace, MiMo transcription CLI, and Agent Skill.",
  "license": "MIT",
  "homepage": "https://onefly.top/yanlan-ai/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ranxi2001/yanlan-ai.git"
  },
  "bugs": {
    "url": "https://github.com/ranxi2001/yanlan-ai/issues"
  },
  "keywords": [
    "audio",
    "transcription",
    "asr",
    "mimo",
    "agent-skill",
    "meeting"
  ],
  "bin": {
    "yanlan": "./bin/yanlan.mjs"
  },
  "files": [
    "LICENSE",
    "README.md",
    "bin/",
    "public/THIRD_PARTY_NOTICES.txt",
    "skills/yanlan-transcribe/",
    "src/agent/",
    "src/api.js",
    "src/asr-benchmark-metrics.js",
    "src/asr-context-review.js",
    "src/asr-coverage-harness.js",
    "src/asr-coverage-runtime.js",
    "src/asr-coverage-tail.js",
    "src/asr-pipeline.js",
    "src/asr-quality.js",
    "src/asr-window-planner.js",
    "src/audio-span-locator.js",
    "src/cli.js",
    "src/meeting-content.js",
    "src/reading-transcript.js",
    "src/transcript-speakers.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 4173",
    "dev": "vite --host 127.0.0.1 --port 4173",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "local": "npm run build && node server/local.mjs",
    "cli": "node bin/yanlan.mjs",
    "eval:terminology": "node scripts/terminology-eval.mjs",
    "eval:terminology:agent": "node scripts/terminology-agent-eval.mjs",
    "eval:meeting:agent": "node scripts/meeting-agent-eval.mjs",
    "eval:meeting:content": "node scripts/meeting-content-eval.mjs",
    "eval:transcript:repair": "node scripts/transcript-repair.mjs",
    "eval:asr:windows": "node scripts/asr-window-eval.mjs",
    "eval:asr:boundaries": "node scripts/asr-boundary-confirmation-eval.mjs",
    "eval:asr:boundary-repair": "node scripts/asr-boundary-repair-eval.mjs",
    "eval:asr:benchmark": "node scripts/eval-hf-asr-benchmark.mjs",
    "eval:asr:longform": "node scripts/eval-hf-longform.mjs",
    "eval:asr:longform:score": "node scripts/score-hf-longform.mjs",
    "eval:asr:coverage": "node scripts/eval-asr-coverage.mjs",
    "eval:asr:coverage:score": "node scripts/score-asr-coverage.mjs",
    "eval:asr:coverage:tail": "node scripts/apply-asr-coverage-tail.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "test:browser:content": "node scripts/content-browser-test.mjs",
    "test:browser:long-audio": "node scripts/long-audio-browser-test.mjs",
    "test:browser:races": "node scripts/browser-test.mjs --races-only",
    "test:package": "node scripts/package-test.mjs",
    "check": "node --check src/app.js && node --check src/audio-stream-core.js && node --check src/audio-stream.js && node --check src/audio-decode-worker.js && node --check src/api.js && node --check src/agent/harness.js && node --check src/agent/responses-adapter.js && node --check src/agent/tool-registry.js && node --check src/agent/trace.js && node --check src/agent/profiles/meeting-analysis.js && node --check src/agent/profiles/terminology.js && node --check scripts/meeting-agent-eval.mjs && node --check scripts/terminology-agent-eval.mjs && node --check src/key-backup.js && node --check src/cli.js && node --check bin/yanlan.mjs && node --check src/storage.js && node --check server/local.mjs && npm test && npm run build",
    "setup:coverage": "python scripts/setup-coverage.py"
  },
  "dependencies": {
    "lucide": "^0.468.0",
    "mediabunny": "1.52.3"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "playwright": "^1.62.0",
    "vite": "^7.0.0"
  }
}
